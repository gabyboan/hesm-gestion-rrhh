# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Artefactos de distribucion (publicar mediante Releases, no en el repositorio)
/dist/
/.history-backups/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Credenciales / variables de entorno
.env
.env.*
*.env
credenciales.env

# Scripts operativos locales con asignaciones nominales
/supabase/manual/

# Dumps / scripts SQL locales
*.sql
!/supabase/migrations/*.sql
!/supabase/tests/*.sql
!/supabase/audits/seguridad_rendimiento.sql

# Supabase CLI local state
supabase/.temp/

# Permitir ejemplos sin datos reales
!.env.example
!*.env.example

